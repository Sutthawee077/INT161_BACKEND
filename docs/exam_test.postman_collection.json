{
  "info": {
    "_postman_id": "b75ee584-36cc-4780-99b2-ea5ac80ff1c0",
    "name": "INT161 Backend Exam Test Collection",
    "description": "ชุดทดสอบ API สำหรับวิชา INT161 Backend Development ครบถ้วนทุกข้อ (200, 201+Location, 204, 400, 404, 405, 406, 409, 415)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api/v1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Brands",
      "item": [
        {
          "name": "1.1 Get All Brands (200 OK)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/brands",
              "host": ["{{baseUrl}}"],
              "path": ["brands"]
            }
          }
        },
        {
          "name": "1.2 Post Brand Not Allowed (405)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"name\": \"Forbidden Brand\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/brands",
              "host": ["{{baseUrl}}"],
              "path": ["brands"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Products - List & Filter",
      "item": [
        {
          "name": "2.1 Get All Products (200 OK)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": ["{{baseUrl}}"],
              "path": ["products"]
            }
          }
        },
        {
          "name": "2.2 Filter by Brand ID 1 (200 OK)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/products?brandId=1",
              "host": ["{{baseUrl}}"],
              "path": ["products"],
              "query": [
                { "key": "brandId", "value": "1" }
              ]
            }
          }
        },
        {
          "name": "2.3 Filter by Non-Existent Brand (200 OK Empty)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/products?brandId=999",
              "host": ["{{baseUrl}}"],
              "path": ["products"],
              "query": [
                { "key": "brandId", "value": "999" }
              ]
            }
          }
        }
      ]
    },
